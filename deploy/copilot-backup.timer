[Unit]
Description=每天备份一次数据库和用户上传的原件
# timer 和它触发的 service 同名（copilot-backup），systemd 自动配对

[Timer]
# 每天 UTC 20:10 = 北京时间次日 04:10。
#
# ⭐ **和 copilot-sync.timer 错开。** 那个在 UTC 04:10（北京中午）跑同步，
# 同步会重写大量 chunks；备份撞在同步中间的话，dump 出来的是一个
# 「一半旧一半新」的快照 —— 恢复得回来，但内容对不上任何一个时刻。
# 备份挑真正没人用、也没有定时任务的时段：北京凌晨四点。
OnCalendar=*-*-* 20:10:00 UTC

# 机器关机错过了就开机补跑。
# ⚠️ 这条对备份比对同步更要紧：同步错过一次是知识库晚半个月更新，
# 备份错过一次是**那一天的数据没有任何副本**，而它一样没有外部症状。
Persistent=true

# 随机延迟 5 分钟。这台机器上没有别的定时任务会撞车，
# 加这个纯粹是避免「每天精确同一秒」这种规律 —— 万一以后加了别的任务，
# 它们会永远撞在一起
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
