[Unit]
Description=每天增量同步一次语雀知识库
# timer 和它触发的 service 同名（copilot-sync），systemd 自动配对，
# 不用写 Unit= —— 写错了会静默地什么都不触发

[Timer]
# 每天 04:10 UTC = 北京时间 12:10。
#
# 为什么不选凌晨：这台机器 1.6GB，同步 + 入库要占几百 MB，而**语雀那边是
# 白天有人改文档**——半夜跑等于用最紧张的时段去同步最不可能有变化的内容。
# 中午跑，改动当天就能进库，而且此时用的人少。
OnCalendar=*-*-* 04:10:00 UTC

# 机器关机/重启错过了这次，开机后补跑一次。不加这条的话，
# 一次意外重启就让知识库停更一天，而没人会注意到
Persistent=true

# 随机延迟最多 10 分钟：避免每天都在同一秒对语雀发起几百个请求，
# 那种规律的流量最像爬虫
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
