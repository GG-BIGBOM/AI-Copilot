[Unit]
Description=每 15 天增量同步一次语雀知识库
# timer 和它触发的 service 同名（copilot-sync），systemd 自动配对，
# 不用写 Unit= —— 写错了会静默地什么都不触发

[Timer]
# 每月 1 号和 16 号的 04:10 UTC = 北京时间 12:10，即约每 15 天一次。
#
# ⭐ **为什么不用 `OnUnitActiveSec=15d`**：那个是「距上次运行满 15 天」，
# 一次重启或一次手动 `systemctl start` 就把周期重新起算，跑久了没人说得清
# 下一次是什么时候。写死日历日期，`systemctl list-timers` 上永远看得见准确的下一次。
#
# 为什么不选凌晨：这台机器 1.6GB，同步 + 入库要占几百 MB，而**语雀那边是
# 白天有人改文档**——半夜跑等于用最紧张的时段去同步最不可能有变化的内容。
# 中午跑，改动当天就能进库，而且此时用的人少。
OnCalendar=*-*-01,16 04:10:00 UTC

# 机器关机/重启错过了这次，开机后补跑一次。
# ⚠️ 周期从 1 天拉到 15 天之后这条更要紧了：错过一次就是**停更半个月**，
# 而知识库停更这件事没有任何外部症状——答案只是慢慢变旧
Persistent=true

# 随机延迟最多 10 分钟：避免每次都在同一秒对语雀发起几百个请求，
# 那种规律的流量最像爬虫
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
