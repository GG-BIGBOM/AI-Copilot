# 复制成 deploy/.env 后填真实值。deploy/.env 已在 .gitignore 里，永不入库。
#
# 为什么单独有这个文件：仓库是公开的，而 deploy/*.sh 需要知道往哪台机器推。
# 把地址写死在脚本里，等于把生产环境的地址一起开源。

# 部署目标。格式 user@host，deploy.sh / backup-pull.sh 都读它
COPILOT_HOST=root@你的服务器地址

# SSH 私钥路径。不填就用默认的 ~/.ssh/erp_vps
#COPILOT_SSH_KEY=$HOME/.ssh/erp_vps

# 备份拉取的两端目录，不填走 backup-pull.sh 里的默认值
#COPILOT_BACKUP_DIR=/var/backups/copilot
#COPILOT_BACKUP_LOCAL=/d/backups/copilot
