# 复制成 .env 后填写真实值。.env 已在 .gitignore 里，永不入库。
# 服务器上记得 chmod 600 .env

# ===== 数据库 =====
DATABASE_URL=postgresql+asyncpg://kb:改成你的密码@localhost:5432/kb

# ===== SiliconFlow（embedding + rerank，免费额度）=====
# 注册：https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxx

# ===== LLM（生成答案）=====
# DeepSeek：https://platform.deepseek.com
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== 认证 =====
# 生成一个随机串：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 不改这个值服务起不来——顶着占位密钥对外服务 = 任何人都能自己签一个登录态
JWT_SECRET=换成随机长字符串

# cookie 的 Secure 属性。本地 http 开发必须是 false，否则浏览器根本不存 cookie；
# 线上 HTTPS 改成 true。它同时控制是否关闭 /api/docs
COOKIE_SECURE=false

# ===== API =====
# 允许跨源带 cookie 的前端地址，逗号分隔。
# 本地开发：前端 3000 / 后端 8000，跨源。线上前后端同源，这条用不上
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== 视觉：读图转文字（图片上传 + 扫描件 PDF）=====
# ⚠️ **不能复用 LLM_API_KEY**：答题走 DeepSeek，它没有视觉能力。
# 这里走 Kimi（https://platform.moonshot.cn），国内服务器可直连（实测 200 / 3.2s）。
# 不填的话：图片仍能上传，但解析会失败并显示「服务端没有配置图片解析」
VISION_API_KEY=sk-xxxxxxxxxxxxxxxx
VISION_BASE_URL=https://api.moonshot.cn/v1
VISION_MODEL=moonshot-v1-32k-vision-preview

# 扫描件 PDF 逐页读图的页数上限。**这是一道花钱的闸门**：一页约 ¥0.01–0.03
VISION_PDF_MAX_PAGES=20

# ===== 评测判分（M8，只在本机）=====
# ⚠️ 判分模型必须和答题模型**不同厂**，否则是自己判自己（self-preference bias）。
# 现用 Gemini：https://aistudio.google.com/apikey
# ⭐ 两个坑：
#   1. 要走 OpenAI 兼容端点（结尾那个 /openai），原生端点的鉴权方式不一样
#   2. **国内服务器连不上 Google**（实测 15s 超时）。评测本来就只在本机跑
EVAL_JUDGE_API_KEY=AQ.xxxxxxxxxxxxxxxx
EVAL_JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EVAL_JUDGE_MODEL=gemini-2.5-pro
