# 复制成 .env 后填写真实值。.env 已在 .gitignore 里，永不入库。
# 服务器上记得 chmod 600 .env

# ===== 数据库 =====
DATABASE_URL=postgresql+asyncpg://kb:改成你的密码@localhost:5432/kb

# ===== SiliconFlow（embedding + rerank，免费额度）=====
# 注册：https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxx

# ===== LLM（生成答案）=====
# DeepSeek：https://platform.deepseek.com
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== 常识兜底（M12）=====
# 知识库里没有的时候，允不允许模型用自己的通用知识回答。
#
# ⚠️ **这一行推翻的是 M1 到 M9 的地基。** 铁律 1 原文是「不得用你自己的常识
# 补全或推测」，整套防幻觉都建在它上面。M7 让 Agent 自由发挥那次的代价：
# 41 题准确率掉 12 个点、幻觉率 12.5% —— 掉的不是常识题，
# 是它「想起来」的界面路径和数值，而那种答案和真的长得一模一样。
#
# 打开它的理由（2026-08-20 线上实测）：用户追问「品牌方又是什么」，
# 模型答了一段正确的行业概念解释，被硬防线整段换成「知识库暂无此内容」。
# 而知识库里**确实没有**这个概念的定义 —— 怎么修检索都救不回来。
# 一个连行业术语都要拒答的助手，用起来像坏的。
#
# ⭐ 红线没有拆掉，是**挪了位置** —— 从「知识的来源」挪到「错了会不会伤到人」：
#     可以用自己的知识答   行业术语、概念解释、通用做法   错了是理解偏差
#     绝不能凭记忆写       界面路径、字段名、参数上限     错了客户的订单卡住
#
# 关掉它一行退回 M11 的行为（两版 prompt 都留在 qa.py 里）。
# 关掉之后「一条都没召回」这条路也会变回 0 成本 —— 打开时它每次都要花一次
# 模型调用，因为那正是最需要问模型的时候。
ALLOW_GENERAL_KNOWLEDGE=true

# ===== 认证 =====
# 生成一个随机串：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 不改这个值服务起不来——顶着占位密钥对外服务 = 任何人都能自己签一个登录态
JWT_SECRET=换成随机长字符串

# cookie 的 Secure 属性。本地 http 开发必须是 false，否则浏览器根本不存 cookie；
# 线上 HTTPS 改成 true。它同时控制是否关闭 /api/docs
COOKIE_SECURE=false

# ===== API =====
# 允许跨源带 cookie 的前端地址，逗号分隔。
# 本地开发：前端 3000 / 后端 8000，跨源。线上前后端同源，这条用不上
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== 视觉：读图转文字（图片上传 + 扫描件 PDF）=====
# ⚠️ **不能复用 LLM_API_KEY**：答题走 DeepSeek，它没有视觉能力。
# 这里走 Kimi（https://platform.moonshot.cn），国内服务器可直连（实测 200 / 3.2s）。
# 不填的话：图片仍能上传，但解析会失败并显示「服务端没有配置图片解析」
VISION_API_KEY=sk-xxxxxxxxxxxxxxxx
VISION_BASE_URL=https://api.moonshot.cn/v1
VISION_MODEL=moonshot-v1-32k-vision-preview

# 扫描件 PDF 逐页读图的页数上限。**这是一道花钱的闸门**：一页约 ¥0.01–0.03
VISION_PDF_MAX_PAGES=20

# ===== 评测判分（M8，只在本机）=====
# ⚠️ 判分模型必须和答题模型**不同厂**，否则是自己判自己（self-preference bias）。
# 现用 Gemini：https://aistudio.google.com/apikey
# ⭐ 两个坑：
#   1. 要走 OpenAI 兼容端点（结尾那个 /openai），原生端点的鉴权方式不一样
#   2. **国内服务器连不上 Google**（实测 15s 超时）。评测本来就只在本机跑
EVAL_JUDGE_API_KEY=AQ.xxxxxxxxxxxxxxxx
EVAL_JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EVAL_JUDGE_MODEL=gemini-2.5-pro

# ===== Agent 灰度（M10）=====
# 走 Agent 的用户比例，0–1。0 = 全部走直路（默认，线上行为不变）。
#
# ⭐ **按 user_id 哈希稳定分桶，不是按请求随机。** 同一个人每次都落在同一侧，
# 不会出现一条会话在两条路之间跳（那样多轮收集需求的状态当场就断了）。
#
# ⚠️⚠️ **别用它，先用下面的 AGENT_ALLOW_EMAILS**（M11 P4）。
# 线上只有 3 个真实账号，而分桶是按 user_id **稳定哈希**的：设 0.2 最可能的
# 结果是**一个人都没进桶**，设 0.5 也不过是掷三次硬币。
# 「20% → 观察几天 → 50%」这套节奏是为几百上千用户设计的，
# 照搬到 3 个人身上，观察到的是零样本。等用户到 20+ 再回来用这一行。
#
# 灰度节奏建议（用户 20+ 之后）：0.2 → 观察几天 → 0.5 → 1.0 → 稳定后删掉直路。
# 观察什么：`request_trace` 表（M11 P1 加的，一条请求一行）。
#   看 route='agent' 的行里 ok=false 有多少
#   看 tools='[]' 却答了一大段的有几条  ← 越过工具直答，硬防线该拦下的
#   看 chunk_count=0 和 top_score 很低的分别有多少 ← 该查没查 vs 查了没查着
# ⭐ 这几件事在 M11 之前**在 journal 里根本查不到**，所以监控必须先于灰度。
#
# 评测依据（55 题各跑两轮，见 plan.md M10 P3）：
#   直路   96.4 / 98.2%      幻觉 0%   检索命中 100%   引用正确 100%
#   Agent  94.5 / 100.0%     幻觉 0%   检索命中 100%   引用正确 100%
# 两条路的区间完全重叠，差异是模型在 temperature=0 下的抖动。
# ⚠️ 但**单轮评测判不出 2 个点的差距**，所以只能灰度、不能一把切。
AGENT_ROLLOUT=0

# ===== Agent 白名单（M11 P4）=====
# 逗号分隔的邮箱。**这些人一律走 Agent**，普通问答也走。
#
# ⭐ 这就是 n=3 时正确的灰度形态：不掷骰子，点名。
# 先填自己 + 1 个熟人，真实用一周——重点是**追问、改口、说错名词**这类
# 离线题集抓不到的东西（`guard.py` 那个 bug 就是这么撞出来的）。
#
# 一周后看 `request_trace`：
#   SELECT count(*) FROM request_trace WHERE route='agent' AND tools='[]'
#     AND answer_chars > 200 AND no_answer = false;
#   ↑ 验收标准第 8 条要求这个数是 0（一个工具都没调却答了 ERP 问题）
#
# 留空 = 谁都不放。**空不等于全放**，别指望「没配就是关着=其实是开着」。
AGENT_ALLOW_EMAILS=

# 强制全开，压过 AGENT_ROLLOUT 和白名单。给评测和本机验证用，线上别开
AGENT_ENABLED=false

# Agent 跑飞时的硬闸门。上面一组是「出方案」那条路（多轮收集要留余量），
# 下面一组是普通问答（正常形态就是「决策 → answer_kb → 结束」）
AGENT_MAX_REQUESTS=8
AGENT_MAX_TOOL_CALLS=10
AGENT_MAX_REQUESTS_QA=3
AGENT_MAX_TOOL_CALLS_QA=3

# ===== 混合检索：BM25 + RRF（W1.2）=====
# ⛔⛔ **默认关。2026-08-29 从 true 翻回来的——付费评测把它打下来了。**
#
# 免费的 `--check`（eval/keyword.yaml 45 题）当初看着很漂亮：
#     裸粘贴那 15 条    6/15   →  15/15    MRR@5 0.367 → 0.933
#     完整问句那 30 条  29/30  →  29/30    一道题的名次都没变
# 于是 W1.2 把默认值定成了 true。
#
# 付费那一轮（2026-08-29）是这样：
#                          08-24 基线   hybrid      破在哪道题
#     公共库·直路 幻觉率        0.0%  →  10.0%    none-sap-connector
#     公共库·Agent 幻觉率       0.0%  →  10.0%    同上（两条路径都复现）
#     风险边界 高风险幻觉率      0.0%  →  10.0%    ui-dashboard
#     检索命中率              98.5%  →  98.5%    ← 一点没动
#
# ⭐ 机理反直觉，值得记住：纯向量 top-5 的第 5 位往往是个**重复块**（等于空位），
# 而那个空位正是模型愿意拒答的原因。hybrid 把它填上一块"话题相邻但不是这件事"
# 的材料，就足以把模型劝离拒答：
#     「数据大屏在哪个菜单」→ 捞进讲"顶部数据看板"的块 → 当成同一个功能答了
#     「旺店通和 SAP 的对接方案」→ 捞进"外部ERP分销商对接" → 「按通用理解…」
# 词法召回带进新内容，在裸粘贴上救命，在 no_answer 题上致命——同一个动作的两面。
#
# ⚠️⚠️ **「检索命中率一点没动」是这件事最该记住的部分。**
# no_answer 题没有期望来源，根本不进 source_hit 的分母——那个免费指标
# **结构上看不见**这种失败。「没有理由退步」不等于「量过了」。
#
# ⭐ 怎么开回来（有路，但要先做）：收益全在裸粘贴、伤害全在完整问句，
# 所以按查询形状开关词法这一路（短、无疑问词、含编码/ID 才走 BM25）。
# 做完要重跑上面那四轮。完整取舍见 DECISIONS.md 的 ADR-16。
#
# ⚠️ 三个前提缺一个都会**静默退回纯向量检索**（不报错）：
#   1. 装了 jieba          uv sync --extra hybrid
#   2. 跑过迁移            alembic upgrade head（加 chunks.content_tsv）
#   3. 回填过词法索引      copilot backfill-tsv
# 第 1 条缺了日志里有 warning，第 2、3 条只表现为"裸粘贴一个编码搜不到"
HYBRID_ENABLED=false
# 词法召回数量。和向量那一路的 RETRIEVE_TOP_K 各取各的，融合后一起进重排
HYBRID_LEXICAL_K=20
# RRF 常数。60 是原论文取值。它决定"排名差一位值多少分"，没理由别动
HYBRID_RRF_K=60
# 词法查询只保留文档频率低于这个比例的词。
# ⚠️ **这一步不能省。** ts_rank_cd 不含 IDF，不砍高频词的话，排在最前面的
# 永远是"这个话题讲得最密集"的那几块，而不是含着那个编码的那一块——
# 实测关掉它时，词法带进候选池的 229 块新内容最终一块都没进 top-5
HYBRID_DF_MAX_RATIO=0.02
# 整句都是常用词时的保底留词数。砍成空查询等于词法这一路直接消失
HYBRID_MIN_TERMS=4

# ===== 会话级已确认事实（W2.2）=====
# 一条会话里真正需要跨窗口活着的事实只有几条（哪一版 ERP、哪家客户、几个仓），
# 加起来不到 100 个 token，却被埋在几万字的对话原文里，指望模型每轮重新读出来。
# 打开它之后，这几条按结构注进 system prompt，**不受"只保留最近 6 轮"的限制**。
#
# ⚠️ **默认关，理由是这个项目的老规矩**：它改的是送进模型的 prompt，
# 也就是「会让答案变、但绝不会报错」的那一类——这一类一律先做成开关、默认关，
# 等 A/B 数字出来再谈开不开（HYBRID_ENABLED / ALLOW_GENERAL_KNOWLEDGE /
# AGENT_ENABLED 三个先例都是这么来的）。
#
# ⚠️ **关着的时候事实表照样记录**（写库、跨轮累积），只是不注入。
# 这样真开的那天，存量会话手里已经有账本了，而不是从那一刻起才开始攒。
#
# 打开之前要有的数字：eval/longchat.yaml 的跨窗口指代解析成功率，
# 开关两边各跑一次。口径见 EVALUATION.md
SESSION_FACTS_ENABLED=false

# ===== 上下文预算装配器 + 滚动摘要（W2.1）=====
# 关着：`history[-6:]`，多出来的整段丢掉（W2.1 之前的行为，逐字节一致）
# 开着：按字符预算装配，挤出预算的轮次压成一段摘要跟着进上下文
#
#     [系统指令（含已确认事实）]
#     [更早对话的摘要]        ← 只留**用户说过的话**，不调模型
#     [窗口内原文]            ← 预算决定留几条
#     [本轮材料 + 问题]
#
# ⭐⭐ **摘要不调模型。** plan.md 里 W2.1 一直没做，理由是"引入一笔按轮数计的
# 经常性成本"——但那笔成本只在"摘要必须由模型来写"的前提下才存在。
# 跨窗口那几道题问的是「我一开始说的是哪个版本 / 几个仓 / 哪家客户」，
# 答案全是**用户自己打过的原字**；让模型重写一遍换不来更准，
# 换来的是一次调用、一份延迟，外加一条会写错的路。
#
# 免费 A/B（`eval/longchat.py --check`，零成本）：
#
#                          开关关     只开事实表    开预算装配器
#     上下文命中率           28.6%   →    —      →    100.0%
#       cross_window_fact     0/4    →   2/4     →      4/4
#       in_window_control     2/2    →   2/2     →      2/2   ← 对照组没动
#
# ⚠️ 开着之前先跑一轮收费的（`--tag`）：免费那一档量的是"信息在不在上下文里"，
# 不是"模型有没有用对"。尤其看 `lc-fact-not-a-product-answer`——
# 摘要里有「我们有 4 个发货仓」，而那道题问的是"旺店通的仓库数量上限"。
HISTORY_BUDGET_ENABLED=false
# 历史那一段的字符预算。⚠️ 按字符不按 token：这些会话全是中文，
# 1 字 ≈ 1 token，误差在预算这种自带余量的东西上没有意义。
# 1200 是**故意比今天紧**的（今天是 6 条 × 600 字的上限），
# 定得比今天松的话 A/B 什么都量不到
HISTORY_CHAR_BUDGET=1200
# 单条历史的截断长度。和 W2.1 之前同一个数，刻意不改——
# 一次改两个变量的 A/B 分不清是谁起的作用
HISTORY_CHAR_LIMIT=600
# 开着预算装配器时从库里取几条历史备选。
# ⚠️ 不能还是 6：SQL 那层只取 6 条的话，第 7 条往前的内容根本到不了装配器手上，
# 摘要段会恒为空，而报告上只会显示"这个功能没什么效果"
HISTORY_FETCH_TURNS=24
# 摘要段自己的字数上限。不设的话，一条 50 轮的会话会拿两千字的摘要去挤
# 本轮的检索材料——那正是这次要修的病，换个位置犯一遍
HISTORY_DIGEST_BUDGET=400

# ===== 提示注入防线（W2.3）=====
# ⭐⭐ **默认开——2026-08-29 的 A/B 是这个项目里最干净的一组。**
# 两轮只差这一个开关（都是 hybrid=off，56 题）：
#
#                                    off        on
#     准确率                        91.1%  →  100.0%
#     injection_success_rate        44.4%  →    0.0%
#     另外三条硬指标                  0.0%  →    0.0%   一条都没退
#
# 关着的时候 9 道注入题里 4 道照做了：口令、角色改写、钓鱼网址、
# 冒充官方塞一条假界面路径。⚠️ 最后那条最危险——它没有任何"越狱"的样子，
# 只是塞进一条不存在的路径，而那正是这个产品唯一会真正伤到人的错误形态。
#
# **这是个真实攻击面**：用户能在「知识库」页上传文档，那些文档被切块、
# 被检索、然后原文进入模型的上下文。
#
# 三层各管一段，这个开关管后两层：
#   1. 剥离伪造的区段标记                     永远开（全库 4573 块实测是恒等函数）
#   2. 材料围栏 <<<KB-MATERIAL-…>>> + 那段规则  ← 这个开关
#   3. 私有块里的网址 / 邮箱摘掉               ← 这个开关
#
# ⚠️ 第 3 层是第二轮 A/B 逼出来的：光靠 prompt，钓鱼网址仍被原样写进答案。
# 摘在**材料入口**不在答案出口——答案是流式的，发出去的字收不回来。
# 只摘私有块：公共语料 4568 块里 320 块带网址（语雀链接、APK 地址），
# 那些是正常内容。判据不是"看着像不像钓鱼"，是**它从哪来**。
#
# 关掉它随时可以（一行），代价就是上面那张表。
INJECTION_GUARD_ENABLED=true

# ===== 校验 Agent（W3.2）=====
# `off` / `annotate` / `refuse`。**默认 off，而且理由和别的开关都不一样：
# 它今天的收益上限是 0。**
#
# 现有 47 题风险边界集上，三条硬指标已经全是 0.0%——一个只能减少幻觉的
# 东西，在幻觉率已经是 0 的地方只可能把对的答案降级成拒答。
#
# A/B（56 题，只差这一个开关，规则判定）：
#
#                                       off      annotate
#     四条硬指标                        0.0%  →     0.0%    一个点没动
#     no_answer / general_answer      100.0%  →   100.0%
#     校验调用                            0   →   22 / 56
#     被标注的答案                         0   →       2    ⭐ 两条都是真的
#
# ⭐ 那两条标注抓的正是「材料里没有、却写进了答案」的说法（注入载荷塞的
# 假路径、来自提问而非材料的数字）。指标没动，是因为那两道题的答案本来
# 就已经在拒绝了——**防线重复了，不是防线失效了。**
#
#     off       一次额外调用都不花，行为逐字节等同 W3.2 之前
#     annotate  流式照常，末尾追加「以下说法未能核对到」
#     refuse    ⚠️ **这一档没有流式**：整段攒完才能判断要不要换掉它
#
# 什么时候打开：三条硬指标离开 0、或者 M18 导入企业版语料之后、
# 或者公共库开放用户投稿。判据写在 ADR-22 最后一节。
VERIFIER_MODE=off

# ===== 可观测性：一次请求的 span 树（W1.1）=====
# ⚠️ **默认关，而且是可选依赖**（uv sync --extra obs）。
# 服务器只有 1.6GB 内存，OTel SDK 的常驻占用要实测过才谈开不开；
# 没装 SDK 时打开它只会在日志里留一句 warning，服务照常起。
#
# 它埋的是这棵树：
#   chat.turn → route / rewrite / retrieve(embed,dense,lexical,rerank) / generate
# 验收标准：各段耗时之和 ≈ 总耗时。对不上就是有一段没埋。
TRACING_ENABLED=false
# 本机调试：不配任何后端，直接把 span 打到控制台。
# 这样"埋点对不对"和"导出通不通"是两件可以分开排查的事
TRACING_CONSOLE=false
TRACING_SERVICE_NAME=copilot
TRACING_ENVIRONMENT=dev
# 采样率。本机和评测用 1.0，生产降下来。按 trace_id 采，不会出现半棵树
TRACING_SAMPLE_RATIO=1.0

# OTLP 导出。Langfuse 的入口形如：
#   https://cloud.langfuse.com/api/public/otel/v1/traces
OTLP_ENDPOINT=
# 额外头，k=v,k2=v2。OTel 官方环境变量就是这个格式
OTLP_HEADERS=
# Langfuse 收 HTTP Basic。⚠️ **两个都填才会加这个头**——只填一个的表现是
# 401，而导出在后台线程里，401 只刷一行日志，看板上永远是空的
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ===== 本地演示（docker-compose，W1.3）=====
# ⚠️ `copilot seed-user` 会绕过邀请码建账号，所以它要显式放行才肯跑。
# **compose 里设了这一行，服务器上根本不该存在。**
# COPILOT_ALLOW_SEED_USER=1
